#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Layer definitions matching L0 through L5
#define L0  0
#define L1  1
#define L2  2
#define L3  3
#define L4  4
#define L5  5

/ {
    behaviors {
        // Home row modifier helpers (Hold-Tap)
        mt_gui: mt_gui {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        mt_alt: mt_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        mt_ctl: mt_ctl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        mt_sht: mt_sht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // Combo key shortcuts defined in L3, L4, and L5
        alt_slash: alt_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp FSLH>, <&macro_release &kp LALT>;
        };
        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp TAB>, <&macro_release &kp LALT>;
        };
        shift_ins: shift_ins {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp INS>, <&macro_release &kp LSHFT>;
        };
        ctl_c: ctl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp C>, <&macro_release &kp LCTRL>;
        };
        ctl_v: ctl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp V>, <&macro_release &kp LCTRL>;
        };
        ctl_f: ctl_f {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp F>, <&macro_release &kp LCTRL>;
        };
        ctl_x: ctl_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp X>, <&macro_release &kp LCTRL>;
        };
        ctl_plus: ctl_plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp EQUAL>, <&macro_release &kp LCTRL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // L0: QWERTY Base
        layer_0 {
            bindings = <
                &kp Q         &kp W         &kp E         &kp R         &kp T            &kp Y         &kp U         &kp I         &kp O         &kp P
                &mt_gui LGUI A &mt_alt LALT S &mt_ctl LCTRL D &mt_sht LSHFT F &kp G        &kp H         &mt_sht RSHFT J &mt_alt RALT K &mt_ctl RCTRL L &mt_gui RGUI BSPC
                &kp Z         &kp X         &kp C         &kp V         &kp B            &kp N         &kp M         &kp SQT       &kp DOT       &kp FSLH
                                            &lt L2 DEL    &lt L3 SPACE                   &lt L4 ENTER  &lt L5 TAB
            >;
        };

        // L1: Colemak / Secondary Base
        layer_1 {
            bindings = <
                &kp Q         &kp W         &kp F         &kp P         &kp B            &kp J         &kp L         &kp U         &kp Y         &kp BSPC
                &mt_gui LGUI A &mt_alt LALT R &mt_ctl LCTRL S &mt_sht LSHFT T &kp G        &kp M         &mt_sht RSHFT N &mt_ctl RCTRL E &mt_alt RALT I &mt_gui RGUI O
                &kp Z         &kp X         &kp C         &kp D         &kp V            &kp K         &kp H         &kp SQT       &kp DOT       &kp FSLH
                                            &lt L2 DEL    &lt L3 SPACE                   &lt L4 ENTER  &lt L5 TAB
            >;
        };

        // L2: Numbers & Keypad
        layer_2 {
            bindings = <
                &kp N1        &kp N2        &kp N3        &kp N4        &kp N5           &kp N6        &kp N7        &kp N8        &kp N9        &kp N0
                &trans        &trans        &trans        &trans        &kp ASTRK        &kp PLUS      &kp N4        &kp N5        &kp N6        &trans
                &trans        &trans        &kp DOT       &kp COMMA     &kp FSLH         &kp MINUS     &kp N1        &kp N2        &kp N3        &kp EQUAL
                                            &trans        &trans                         &trans        &trans
            >;
        };

        // L3: Navigation & Editing
        layer_3 {
            bindings = <
                &trans        &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans        &trans
                &trans        &trans        &caps_word    &kp ESC       &alt_slash       &alt_tab      &kp LEFT      &kp DOWN      &kp UP        &trans
                &kp PSCRN     &kp LALT      &kp LALT      &kp LALT      &kp INS          &shift_ins    &kp HOME      &kp PG_DN     &kp PG_UP     &kp RIGHT
                                            &trans        &trans                         &trans        &trans
            >;
        };

        // L4: Symbols
        layer_4 {
            bindings = <
                &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT        &kp CARET     &kp AMPS      &kp ASTRK     &kp GRAVE     &trans
                &trans        &kp LBRC      &kp LBKT      &kp LPAR      &alt_slash       &trans        &kp SQT       &kp COLON     &kp SEMI      &kp TILDE
                &trans        &kp RBRC      &kp RBKT      &kp RPAR      &trans           &trans        &kp UNDER     &kp PIPE      &kp BSLH      &kp DQT
                                            &trans        &trans                         &trans        &trans
            >;
        };

        // L5: Function Keys, Bluetooth & Shortcuts
        layer_5 {
            bindings = <
                &kp F1        &kp F2        &kp F3        &kp F4        &trans           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
                &kp F5        &kp F6        &kp F7        &kp F8        &alt_slash       &bt BT_CLR    &trans        &trans        &trans        &trans
                &kp F9        &kp F10       &kp F11       &kp F12       &trans           &ctl_f        &ctl_plus     &ctl_c        &ctl_v        &trans
                                            &trans        &trans                         &trans        &trans
            >;
        };
    };
};