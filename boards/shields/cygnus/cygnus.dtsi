#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &layout_cygnus_34;
    };

    // Matrix definition: 4 Rows (3 finger rows + 1 thumb row) x 5 Columns
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 0 (Top)
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 1 (Mid)
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 2 (Bot)
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 3 (Thumbs)
            ;

        col-gpios
            = <&pro_micro 14 GPIO_ACTIVE_HIGH>  // Col 0 (Outer)
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>  // Col 1 (Pinky)
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>  // Col 2 (Ring)
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>  // Col 3 (Middle)
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>  // Col 4 (Index)
            ;
    };

    // Matrix transform for 34 keys (17 keys per half: 3x5 + 2 thumbs)
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;

        map = <
            // Left Half                           Right Half
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                            RC(3,3) RC(3,4)    RC(3,5) RC(3,6)
        >;
    };

    layout_cygnus_34: layout_cygnus_34 {
        compatible = "zmk,physical-layout";
        display-name = "Cygnus 34-key";
        transform = <&default_transform>;
        kscan = <&kscan0>;
    };
};