#include "cygnus.dtsi"

&default_transform {
    col-offset = <5>;
};

/* Right half, columns from inner to outer pinky: pins 14, 15, 18, 19, 20.
 * Thumb keys sit on the first two columns (pins 14 and 15). */
&kscan0 {
    col-gpios
        = <&pro_micro 14 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>
        ;
};
