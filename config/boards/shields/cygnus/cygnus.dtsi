#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)     RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)     RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)     RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0)                 RC(3,3) RC(3,4)     RC(3,5) RC(3,6)                 RC(3,9)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        /* Format: <&key_physical_attrs width height x y rotation rx ry> (1u = 100) */
        keys
            /* Row 0 */
            = <&key_physical_attrs 100 100    0  50 0 0 0>
            , <&key_physical_attrs 100 100  100  20 0 0 0>
            , <&key_physical_attrs 100 100  200   0 0 0 0>
            , <&key_physical_attrs 100 100  300  20 0 0 0>
            , <&key_physical_attrs 100 100  400  30 0 0 0>
            , <&key_physical_attrs 100 100  700  30 0 0 0>
            , <&key_physical_attrs 100 100  800  20 0 0 0>
            , <&key_physical_attrs 100 100  900   0 0 0 0>
            , <&key_physical_attrs 100 100 1000  20 0 0 0>
            , <&key_physical_attrs 100 100 1100  50 0 0 0>

            /* Row 1 */
            , <&key_physical_attrs 100 100    0 150 0 0 0>
            , <&key_physical_attrs 100 100  100 120 0 0 0>
            , <&key_physical_attrs 100 100  200 100 0 0 0>
            , <&key_physical_attrs 100 100  300 120 0 0 0>
            , <&key_physical_attrs 100 100  400 130 0 0 0>
            , <&key_physical_attrs 100 100  700 130 0 0 0>
            , <&key_physical_attrs 100 100  800 120 0 0 0>
            , <&key_physical_attrs 100 100  900 100 0 0 0>
            , <&key_physical_attrs 100 100 1000 120 0 0 0>
            , <&key_physical_attrs 100 100 1100 150 0 0 0>

            /* Row 2 */
            , <&key_physical_attrs 100 100    0 250 0 0 0>
            , <&key_physical_attrs 100 100  100 220 0 0 0>
            , <&key_physical_attrs 100 100  200 200 0 0 0>
            , <&key_physical_attrs 100 100  300 220 0 0 0>
            , <&key_physical_attrs 100 100  400 230 0 0 0>
            , <&key_physical_attrs 100 100  700 230 0 0 0>
            , <&key_physical_attrs 100 100  800 220 0 0 0>
            , <&key_physical_attrs 100 100  900 200 0 0 0>
            , <&key_physical_attrs 100 100 1000 220 0 0 0>
            , <&key_physical_attrs 100 100 1100 250 0 0 0>

            /* Row 3 (Outer Pinkies + 2 Inner Thumbs per side) */
            , <&key_physical_attrs 100 100    0 350 0 0 0>
            , <&key_physical_attrs 100 100  350 340 0 0 0>
            , <&key_physical_attrs 100 100  450 350 0 0 0>
            , <&key_physical_attrs 100 100  650 350 0 0 0>
            , <&key_physical_attrs 100 100  750 340 0 0 0>
            , <&key_physical_attrs 100 100 1100 350 0 0 0>
            ;
    };
};
