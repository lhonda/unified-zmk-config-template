#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUM  1
#define NAV  2
#define FUN  3
#define SYM  4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* L0: Colemak-DH Base Layer */
        base_layer {
            display-name = "Base";
            bindings = <
                &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J         &kp L          &kp U          &kp Y          &kp BSPC
                &hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LSHFT T  &kp G          &kp M         &hm RSHFT N    &hm RCTRL E    &hm LALT I     &hm RGUI O
                &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K         &kp H          &kp COMMA      &kp DOT        &kp FSLH
                &none                                &lt NUM DEL  &lt NAV SPACE  &lt FUN RET   &lt SYM TAB                                  &none
            >;
        };

        /* L1: Numbers & Math */
        num_layer {
            display-name = "Num";
            bindings = <
                &kp N1      &kp N2      &kp N3       &kp N4       &kp N5          &kp N6       &kp N7         &kp N8         &kp N9         &kp N0
                &trans      &trans      &trans       &trans       &kp KP_MULTIPLY &kp PLUS     &kp N4         &kp N5         &kp N6         &kp EQUAL
                &trans      &trans      &kp DOT      &kp COMMA    &kp FSLH        &kp MINUS    &kp N1         &kp N2         &kp N3         &trans
                &trans                               &trans       &trans          &trans       &trans                                       &trans
            >;
        };

        /* L2: Navigation & Window Shortcuts */
        nav_layer {
            display-name = "Nav";
            bindings = <
                &trans      &trans      &trans       &trans       &trans         &trans        &trans         &kp DOWN       &trans         &trans
                &trans      &trans      &kp CAPS     &kp ESC      &kp LA(FSLH)   &kp LA(TAB)   &kp LEFT       &kp PG_DN      &kp UP         &kp RIGHT
                &kp PSCRN   &kp LA(N2)  &kp LA(N3)   &kp LA(N4)   &kp INS        &kp LS(INS)   &kp HOME       &trans         &kp PG_UP      &kp END
                &kp LA(N1)                           &trans       &trans         &trans        &trans                                       &trans
            >;
        };

        /* L3: Function Keys, Editing & Bluetooth */
        fun_layer {
            display-name = "Fun";
            bindings = <
                &kp F1      &kp F2      &kp F3       &kp F4       &trans         &bt BT_CLR    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3
                &kp F5      &kp F6      &kp F7       &kp F8       &kp LA(FSLH)   &bt BT_SEL 4  &kp LC(A)      &kp LC(C)      &kp LC(V)      &kp LC(X)
                &kp F9      &kp F10     &kp F11      &kp F12      &trans         &trans        &kp LC(F)      &trans         &trans         &trans
                &trans                               &trans       &trans         &trans        &trans                                       &trans
            >;
        };

        /* L4: Symbols */
        sym_layer {
            display-name = "Sym";
            bindings = <
                &kp EXCL    &kp AT      &kp HASH     &kp DLLR     &kp PRCNT      &kp CARET     &kp AMPS       &kp ASTRK      &kp GRAVE      &kp TILDE
                &trans      &kp LBRC    &kp LBKT     &kp LPAR     &kp LA(FSLH)   &trans        &kp SQT        &kp COLON      &kp SEMI       &kp DQT
                &trans      &kp RBRC    &kp RBKT     &kp RPAR     &trans         &trans        &kp UNDER      &kp PIPE       &kp BSLH       &trans
                &trans                               &trans       &trans         &trans        &trans                                       &trans
            >;
        };

        /* Reserved layer slot for adding a layer in ZMK Studio */
        extra_layer {
            display-name = "Extra";
            status = "reserved";
        };
    };
};
